package views

import "booklog/logic"

// IndexPage es la pagina principal: usa el layout y le pasa el contenido
templ IndexPage(message, title, author string, books []logic.Book) {
	@Layout(indexContent(message, title, author, books))
}

// indexContent es el contenido de la pagina principal
templ indexContent(message, title, author string, books []logic.Book) {
	<h1>Registro de Libros Leídos</h1>
	if message != "" {
		<article><strong>{ message }</strong></article>
	}
	@BookForm(title, author)
	@BookList(books)
}
