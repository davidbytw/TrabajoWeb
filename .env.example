# el Makefile lo copia a .env si no existe; sin make: cp .env.example .env
# formato NOMBRE=valor, sin espacios alrededor del "=" y sin comillas
# la base los usa solo al inicializar el volumen: si se cambian, hace falta `make down`

POSTGRES_USER=book_user
POSTGRES_PASSWORD=book_pass
POSTGRES_DB=book_db
